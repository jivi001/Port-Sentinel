# Vigilant Port-Sentinel Environment Configuration

# ---------------------------------------------------------------------------
# CORE SETTINGS
# ---------------------------------------------------------------------------
# Host and port to bind the application to
HOST=0.0.0.0
PORT=8600

# ---------------------------------------------------------------------------
# SECURITY (REQUIRED)
# ---------------------------------------------------------------------------
# JWT Secret Key - MUST BE SET IN PRODUCTION!
# Generate a strong key using: openssl rand -hex 32
VIGILANT_JWT_SECRET=

# Allowed CORS origins (comma-separated)
VIGILANT_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8600,http://127.0.0.1:8600,http://frontend:80

# ---------------------------------------------------------------------------
# DATABASE SETTINGS
# ---------------------------------------------------------------------------
# Optional PostgreSQL connection (falls back to local SQLite if empty)
# Format: postgresql://<user>:<password>@<host>:<port>/<db>
# DATABASE_URL=postgresql://vigilant_admin:your_strong_password@db:5432/vigilant

# Postgres Docker Configuration
POSTGRES_USER=vigilant_admin
POSTGRES_PASSWORD=your_strong_password
POSTGRES_DB=vigilant

# ---------------------------------------------------------------------------
# INFLUXDB (OPTIONAL TIME-SERIES METRICS)
# ---------------------------------------------------------------------------
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_ORG=sentinel
INFLUXDB_BUCKET=traffic
# InfluxDB token must match between backend and influxdb container
INFLUXDB_TOKEN=your_secure_token

# InfluxDB Docker Initialization
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=admin_strong_password
