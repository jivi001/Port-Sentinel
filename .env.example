# ============================================================
# Vigilant Enterprise Network Defense — Configuration
# ============================================================
# Copy this file to .env and update values before deployment.
# NEVER commit .env to version control.
# ============================================================

# --- Core Server ---
HOST=127.0.0.1
PORT=8600

# --- Authentication (REQUIRED for production) ---
# JWT signing secret. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
VIGILANT_JWT_SECRET=CHANGE_ME_BEFORE_DEPLOY

# Initial admin password. If unset, a random password is generated and printed to the console on first startup.
# VIGILANT_ADMIN_PASSWORD=

# --- CORS ---
# Comma-separated list of allowed origins. Defaults to localhost origins for development.
# VIGILANT_CORS_ORIGINS=http://localhost:5173,http://localhost:8600

# --- Database ---
# SQLite (default): sqlite:///path/to/sentinel.db
# PostgreSQL:       postgresql://user:password@host:5432/vigilant
# DATABASE_URL=sqlite:///data/sentinel.db

# --- Log Storage ---
# Directory for application logs. Supports local paths, network paths, or external drives.
# LOG_STORAGE_PATH=logs
# LOG_RETENTION_DAYS=90
# LOG_ENCRYPTION_KEY=  # AES-256 key for log encryption at rest. Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# LOG_MAX_SIZE_MB=100
# LOG_COMPRESSION=true

# --- Threat Intelligence ---
# IPInfo.io API token for IP geolocation and ASN enrichment
# IPINFO_TOKEN=

# --- InfluxDB (Optional — time-series metrics) ---
# INFLUXDB_URL=http://localhost:8086
# INFLUXDB_TOKEN=
# INFLUXDB_ORG=vigilant
# INFLUXDB_BUCKET=traffic

# --- Supabase (Optional — cloud sync) ---
# SUPABASE_URL=
# SUPABASE_KEY=

# --- Legacy Compatibility ---
# These are accepted as fallbacks if VIGILANT_* equivalents are not set.
# SENTINEL_API_KEY=
# SENTINEL_JWT_SECRET=
# SENTINEL_CORS_ORIGINS=
